# No trailing slash, deliberately. `node_modules/` matches DIRECTORIES only,
# so it does not ignore a node_modules SYMLINK — and a symlink is exactly what
# this repo grows in a git worktree, because typechecking or running Playwright
# there means pointing web/node_modules at the main checkout's tree. With the
# directory-only rule, `git add -A` in a worktree stages that symlink and
# commits an absolute path that exists on one devbox and nowhere else. Verified
# both ways with git check-ignore against a real symlink.
node_modules
.env
.env.local
*.log
dist/
.next/
coverage/
test-results/
playwright-report/
prisma/*.db
.DS_Store
next-env.d.ts
*.tsbuildinfo

# help-media capture pipeline: tool deps and raw capture scratch.
# .out/ holds Playwright recordings taken against a LOCAL seeded database;
# only the transcoded result under web/public/help-media/ is committed.
tools/help-media/node_modules
tools/help-media/.out/

# Playwright storage state. auth.setup.ts writes REAL signed session JWTs here
# (web/e2e/.auth/<role>.json) so the suite and the help-media capture pass start
# authenticated. web/.dockerignore keeps these out of the built image; this
# keeps them out of git, which is the worse of the two leaks because a pushed
# commit is permanent and public to anyone with repo access.
web/e2e/.auth/
